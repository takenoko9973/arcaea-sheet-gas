{
    "compilerOptions": {
        "target": "ES2019",
        "lib": [
            "ESNext"
        ],
        "rootDir": "src",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "strict": true,
        "types": [
            "jest",
            "node",
            "google-apps-script"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}
