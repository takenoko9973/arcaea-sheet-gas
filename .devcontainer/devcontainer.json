{
    "name": "arcaea-potential",
    "dockerComposeFile": [
        "docker-compose.yml"
        // "overlays/plantuml.compose.yml"
    ],
    "init": true,
    "service": "workspace",
    "workspaceFolder": "/workspace",
    "postCreateCommand": "git config --local core.filemode false",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "settings": {
                "files.watcherExclude": {
                    "**/node_modules/**": true
                },
                "[typescript][javascript]": {
                    "editor.formatOnPaste": true,
                    "editor.formatOnSave": true,
                    "editor.formatOnType": true,
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.codeActionsOnSave": {
                        "source.fixAll.eslint": "explicit"
                    }
                },
                "js/ts.updateImportsOnFileMove.enabled": "always",
                "plantuml.render": "PlantUMLServer",
                "plantuml.server": "http://plantuml-server:8080/"
            },
            "extensions": [
                "codezombiech.gitignore",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "streetsidesoftware.code-spell-checker",
                "mhutchie.git-graph",
                "jebbs.plantuml",
                "fill-labs.dependi"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:USERPROFILE}/.clasprc.json,target=/root/.clasprc.json,type=bind,consistency=cached"
    ]
}
