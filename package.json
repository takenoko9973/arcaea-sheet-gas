    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "directories": {},
  "repository": "git+https://github.com/takenoko9973/arcaea-sheet-gas.git",
